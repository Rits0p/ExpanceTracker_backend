# .env.example — ExpenseTracker Environment Variables Template
# Copy this to .env and fill in your values.
# NEVER commit .env to version control.

# ── Django ────────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=your-strong-secret-key-change-this-in-production
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ── Database ──────────────────────────────────────────────────────────────────
USE_MYSQL=False
# MySQL config (only needed if USE_MYSQL=True)
MYSQL_DATABASE=expensetracker
MYSQL_USER=expenseuser
MYSQL_PASSWORD=
MYSQL_HOST=localhost
MYSQL_PORT=3306

# ── CORS (add your frontend domain) ──────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:5500,http://localhost:80

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT=100/hour

# ── Groq AI API (get key at https://console.groq.com) ────────────────────────
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_API_BASE_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_TEMPERATURE=0.3
GROQ_MAX_TOKENS=600
